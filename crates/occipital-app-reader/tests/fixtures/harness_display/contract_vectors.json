      "name": "frames_present_cold_read_returns_current_accumulated_text",
      "drive": {
        "session": "ses_display_present",
        "ringEntries": 2,
        "frames": [
          { "messageID": "msg_display", "chunk": "read ", "partType": "text" },
          { "messageID": "msg_display", "chunk": "the ring", "partType": "text" }
        ]
      },
      "request": { "session": "ses_display_present" },
      "reply": {
        "seq": 2,
        "frame": {
          "kind": "display",
          "sessionID": "ses_display_present",
          "messageID": "msg_display",
          "chunk": "read the ring",
          "partType": "text"
        }
      }
    },
    {
