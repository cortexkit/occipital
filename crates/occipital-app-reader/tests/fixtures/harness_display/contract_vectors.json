{
  "_provenance": "Producer-real display polling vectors. The module lib test drives coalesced display deltas through ManagerRuntime, then invokes the session.display_read wire arm and compares serialized replies byte-for-byte.",
  "_delivery_notes": {
    "consumer_ping_fields": [
      "absent",
      "seq",
      "frame",
      "frames",
      "windowExpired",
      "oldestSeq",
      "kind",
      "sessionID",
      "messageID",
      "chunk",
      "partType"
    ]
  },
  "vectors": [
